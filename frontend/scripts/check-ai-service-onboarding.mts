import assert from 'node:assert/strict';
import { emptyModelSetup, modelsFromPreset, modelsFromService, mergeDiscoveredModels, modelConfiguration, modelSetupError } from '../src/pages/aiServiceOnboarding.ts';
import { capabilityModels } from '../src/pages/aiServiceCapabilities.ts';
import type { CustomAIService } from '../src/services/agentApi.ts';

const preset = modelsFromPreset({ id: 'openai', name: 'OpenAI', category: '官方', description: '', base_url: 'https://api.openai.com/v1', protocol: 'openai-responses', default_model: 'gpt-4.1', models: ['gpt-4.1', 'gpt-image-1', 'dall-e-3'] });
assert.deepEqual(preset.entries.find(e => e.id === 'dall-e-3')?.suggestions, ['image.generate']);
assert.deepEqual(modelConfiguration(preset).enabled_capabilities, ['chat', 'vision.describe']);
const updatedPreset = modelsFromPreset({ id: 'openai', name: 'OpenAI', category: '官方', description: '', base_url: 'https://api.openai.com/v1', protocol: 'openai-responses', default_model: 'new-template-default', models: ['new-template-default'] });
assert.deepEqual(modelConfiguration(updatedPreset).enabled_capabilities, ['chat'], 'curated template default remains a chat suggestion without name guessing');
let setup = mergeDiscoveredModels(preset, ['gpt-4.1', 'gpt-image-1', 'unknown-vision', 'unknown-vision', '']);
assert.equal(setup.entries.filter(e => e.id === 'unknown-vision').length, 1);
assert.deepEqual(setup.entries.find(e => e.id === 'unknown-vision')?.operations, []);
assert.equal(setup.entries.find(e => e.id === 'unknown-vision')?.selected, false);
assert.equal(setup.entries.some(e => e.id === 'dall-e-3'), false);
setup = { ...setup, entries: setup.entries.map(e => e.id === 'unknown-vision' ? { ...e, selected: true } : e) };
assert.match(modelSetupError(setup), /unknown-vision/);
setup.entries.find(e => e.id === 'unknown-vision')!.operations = ['vision.describe'];
setup.entries.find(e => e.id === 'gpt-4.1')!.selected = false;
const visionOnly = modelConfiguration(setup);
assert.equal(visionOnly.model, '');
assert.deepEqual(visionOnly.models, []);
assert.equal(visionOnly.vision_model, 'unknown-vision');
assert.deepEqual(visionOnly.enabled_capabilities, ['vision.describe']);
setup.entries.push({ id: 'image-b', source: 'manual', selected: true, operations: ['image.generate'], suggestions: [] });
setup.entries.find(e => e.id === 'gpt-image-1')!.selected = true;
setup.defaults['image.generate'] = 'image-b';
const mixed = modelConfiguration(setup);
assert.equal(mixed.image_model, 'image-b');
assert.deepEqual(mixed.media_models['image.generate'], ['gpt-image-1']);
assert.deepEqual(mixed.models, []);
setup.entries.find(e => e.id === 'image-b')!.selected = false;
assert.equal(modelConfiguration(setup).image_model, 'gpt-image-1');
setup = mergeDiscoveredModels(setup, []);
assert.ok(setup.entries.some(e => e.id === 'image-b' && e.source === 'manual'));
assert.ok(setup.entries.some(e => e.id === 'gpt-image-1' && e.selected));
assert.match(modelSetupError(emptyModelSetup()), /至少一个模型/);

const service = { id: 's', model: 'shared', models: ['shared'], image_model: 'shared', media: { 'image.generate': { model: 'shared', adapter: 'openai-images' } }, enabled_capabilities: ['chat', 'image.generate'] } as CustomAIService;
assert.deepEqual(capabilityModels(service, 'chat'), ['shared'], 'same model can provide chat and images');
assert.deepEqual(capabilityModels(service, 'vision.describe'), [], 'explicitly disabled vision must stay disabled');
const loaded = modelsFromService(service);
assert.equal(loaded.entries.length, 1);
assert.deepEqual(loaded.entries[0].operations, ['chat', 'image.generate']);
assert.deepEqual(modelConfiguration(loaded).enabled_capabilities, service.enabled_capabilities);
const legacy = { ...service, media: {}, image_model: '', enabled_capabilities: null };
assert.deepEqual(capabilityModels(legacy, 'vision.describe'), ['shared'], 'legacy fallback stays compatible');
console.log('AI service onboarding logic: passed (catalog, defaults, mixed operations, explicit disable and legacy fallback).');
