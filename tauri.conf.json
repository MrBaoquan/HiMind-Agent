{
  "productName": "HiMind Agent",
  "version": "0.3.55",
  "identifier": "com.himind.agent",
  "build": {
    "frontendDist": "frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HiMind Agent",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
