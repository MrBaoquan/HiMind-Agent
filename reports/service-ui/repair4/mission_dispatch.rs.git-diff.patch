+pub(crate) fn retry_verification(
+    mission_id: &str, task_id: &str, input: &crate::mission::MissionVerificationRetry,
+) -> Result<crate::mission::MissionView, Box<dyn Error>> {
+    let store = MissionStore::open_default()?;
