+    #[test]
+    fn remediation_stream_multidata_error_no_leak() {
+        for (entry, protocol) in [
+            ("openai-chat", "openai-chat"),
+            ("openai-responses", "openai-responses"),
+            ("anthropic", "anthropic"),
+            ("anthropic", "openai-chat"),
+            ("openai-responses", "openai-chat"),
+            ("anthropic", "openai-responses"),
+            ("openai-chat", "openai-responses"),
+        ] {
+            let normal = match protocol {
+                "openai-chat" => "data: {\"choices\":[],\ndata: \"usage\":{\"prompt_tokens\":3,\"completion_tokens\":1}}\n\n",
+                "anthropic" => "data: {\"type\":\"message_start\",\ndata: \"message\":{\"id\":\"r\",\"usage\":{\"input_tokens\":3},\"content\":[]}}\n\n",
+                _ => "data: {\"type\":\"response.created\",\ndata: \"response\":{\"id\":\"r\",\"output\":[]}}\n\n",
+            };
+            for newline in ["\n", "\r\n"] {
+                for prefix in ["", normal] {
+                    for chunk_size in [0, 7] {
+                        for ended in [true, false] {
+                            let error = "data: {\"error\":\ndata: {\"message\":\"FAKE_BEARER_unpatterned_secret\"}}";
+                            let body =
+                                format!("{prefix}{error}{}", if ended { "\n\n" } else { "\n" })
+                                    .replace('\n', newline)
+                                    .into_bytes();
+                            let result = remediation_exchange_chunks(
+                                entry,
+                                protocol,
+                                200,
+                                body.clone(),
+                                body.len(),
+                                true,
+                                chunk_size,
+                            );
+                            for secret in [
+                                "FAKE_BEARER_unpatterned_secret",
+                                "unpatterned_secret",
+                                "FAKE_BEARER",
+                                "\"message\":\"FAKE",
+                            ] {
+                                assert!(
+                                    !result.contains(secret),
+                                    "response leaked {entry}/{protocol}"
+                                );
+                            }
+                            assert!(
+                                result.contains("request_id") && result.contains("himind_gateway_"),
+                                "{result}"
+                            );
+                            assert!(
+                                if prefix.is_empty() {
+                                    result.starts_with("HTTP/1.1 502")
+                                } else {
+                                    result.contains("event: error")
+                                },
+                                "{result}"
+                            );
+                        }
+                    }
+                }
+            }
+            // A valid multiline event is not discarded: terminal events and usage
+            // remain visible to both native relays and line-oriented translators.
+            let terminal = match protocol {
+                "openai-chat" => "data: [DONE]\n\n",
+                "anthropic" => "data: {\"type\":\"message_stop\"}\n\n",
+                _ => "data: {\"type\":\"response.completed\",\ndata: \"response\":{\"id\":\"r\",\"output\":[],\"usage\":{\"input_tokens\":3,\"output_tokens\":1}}}\n\n",
+            };
+            let body = format!("{normal}{terminal}").into_bytes();
+            let result = remediation_exchange_chunks(
+                entry,
+                protocol,
+                200,
+                body.clone(),
+                body.len(),
+                true,
+                7,
+            );
+            assert!(
+                result.starts_with("HTTP/1.1 200") && !result.contains("event: error"),
+                "{entry}/{protocol}: {result}"
+            );
+        }
+        let oversized = format!(
+            "data: {{\"error\":\n{}",
+            "data:  \n".repeat(SSE_LINE_LIMIT / 8 + 1)
+        );
+        let result = remediation_exchange(
+            "openai-chat",
+            "openai-chat",
+            200,
+            oversized.as_bytes().to_vec(),
+            oversized.len(),
+            true,
+        );
+        assert!(
+            result.starts_with("HTTP/1.1 502") && result.contains("response_too_large"),
+            "{result}"
+        );
+        let logs = std::fs::read_to_string(
+            crate::store::paths::agent_home().join("logs/agent-events.jsonl"),
+        )
+        .expect("captured gateway logs");
+        for secret in [
+            "FAKE_BEARER_unpatterned_secret",
+            "unpatterned_secret",
+            "FAKE_BEARER",
+            "FAKE_XAPI",
+        ] {
+            assert!(
+                !logs.contains(secret),
+                "captured logs leaked secret fragment"
+            );
+        }
+        assert!(logs.contains("request_id=") && logs.contains("usage_complete=false"));
+    }
+
