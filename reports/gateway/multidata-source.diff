+    // Real TCP upstream fixture: each request is counted; EOF/truncation never replays.
+    fn remediation_exchange(
+        entry: &str,
+        protocol: &str,
+        status: u16,
+        body: Vec<u8>,
+        declared: usize,
+        sse: bool,
+    ) -> String {
+        remediation_exchange_chunks(entry, protocol, status, body, declared, sse, 0)
+    }
+
+    fn remediation_exchange_chunks(
+        entry: &str,
+        protocol: &str,
+        status: u16,
+        body: Vec<u8>,
+        declared: usize,
+        sse: bool,
+        chunk_size: usize,
+    ) -> String {
+        let upstream = TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = upstream.local_addr().unwrap();
+        let worker = thread::spawn(move || {
+            // Error statuses may use the pre-body transient retry (never body replay).
+            upstream.set_nonblocking(true).unwrap();
+            let deadline = Instant::now() + Duration::from_secs(3);
+            let mut count = 0;
+            while Instant::now() < deadline {
+                let (mut socket, _) = match upstream.accept() {
+                    Ok(pair) => pair,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        thread::sleep(Duration::from_millis(5));
+                        continue;
+                    }
+                    Err(error) => panic!("{error}"),
+                };
+                count += 1;
+                socket.set_nonblocking(false).unwrap();
+                socket
+                    .set_read_timeout(Some(Duration::from_secs(2)))
+                    .unwrap();
+                let _ = read_request(&mut socket).unwrap();
+                let ct = if sse {
+                    "text/event-stream"
+                } else {
+                    "application/json"
+                };
+                if body == b"BAD_CHUNK" {
+                    write!(socket, "HTTP/1.1 200 OK\r\ncontent-type: application/json\r\ntransfer-encoding: chunked\r\nconnection: close\r\n\r\nZZZ\r\ninvalid\r\n").unwrap();
+                    break;
+                }
+                write!(socket,"HTTP/1.1 {status} Test\r\ncontent-type: {ct}\r\ncontent-length: {declared}\r\nconnection: close\r\n\r\n").unwrap();
+                if body == b"TIMEOUT" {
+                    thread::sleep(Duration::from_millis(250));
+                } else {
+                    for part in body.chunks(if chunk_size == 0 {
+                        body.len().max(1)
+                    } else {
+                        chunk_size
+                    }) {
+                        if socket.write_all(part).and_then(|_| socket.flush()).is_err() {
+                            break;
+                        }
+                        if chunk_size != 0 {
+                            thread::sleep(Duration::from_millis(1));
+                        }
+                    }
+                }
+                if status == 200 {
+                    break;
+                }
+            }
+            count
+        });
+        let mut b = binding("remediation", protocol, "local-fixture-token");
+        b.entry_protocol = entry.to_string();
+        b.exposed_model = "model-a".into();
+        b.models = vec!["model-a".into()];
+        b.default_model = "model-a".into();
+        b.upstream_model = "model-a".into();
+        b.base_url = format!("http://{address}");
+        b.api_key = "FAKE_BEARER_unpatterned_secret".into();
+        let mut gateway =
+            InferenceGateway::start(Some(0), Box::new(move || vec![b.clone()]), false).unwrap();
+        let path = match entry {
+            "anthropic" => "/v1/messages",
+            "openai-responses" => "/v1/responses",
+            _ => "/v1/chat/completions",
+        };
+        let request = json!({"model":"model-a","messages":[{"role":"user","content":"hi"}],"input":"hi","max_tokens":8,"stream":sse}).to_string();
+        let mut client = TcpStream::connect(("127.0.0.1", gateway.port())).unwrap();
+        client
+            .set_read_timeout(Some(Duration::from_secs(10)))
+            .unwrap();
+        write!(client,"POST {path} HTTP/1.1\r\nhost: localhost\r\nauthorization: Bearer local-fixture-token\r\nx-api-key: local-fixture-token\r\ncontent-type: application/json\r\ncontent-length: {}\r\nconnection: close\r\n\r\n{request}",request.len()).unwrap();
+        let mut result = String::new();
+        client.read_to_string(&mut result).unwrap();
+        gateway.stop();
+        let count = worker.join().unwrap();
+        let (records, _) = local_usage::read_all().unwrap();
+        let record = records
+            .iter()
+            .rev()
+            .find(|r| r.client == "remediation")
+            .expect("real gateway usage record");
+        assert!(!record.request_id.is_empty());
+        let failed =
+            status != 200 || result.starts_with("HTTP/1.1 502") || result.contains("event: error");
+        assert_eq!(record.status, if failed { "failure" } else { "success" });
+        if failed {
+            assert!(
+                record.usage_unreported,
+                "incomplete usage must not be complete"
+            );
+        } else if !sse {
+            assert!(!record.usage_unreported);
+            assert_eq!(record.input_tokens, 3);
+            assert_eq!(record.output_tokens, 1);
+        }
+        let logs = std::fs::read_to_string(
+            crate::store::paths::agent_home().join("logs/agent-events.jsonl"),
+        )
+        .unwrap_or_default();
+        assert!(!logs.contains("FAKE_BEARER_unpatterned_secret"));
+        assert!(!logs.contains("FAKE_XAPI_unpatterned_secret"));
+        if status == 200 {
+            assert_eq!(count, 1, "body failure must not replay");
+        }
+        result
+    }
