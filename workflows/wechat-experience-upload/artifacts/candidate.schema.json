{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Candidate",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "repository_root",
    "commit_sha",
    "tree_digest",
    "dirty",
    "frozen_at"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow_candidate.v1"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_root": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "minLength": 1
    },
    "tree_digest": {
      "type": "string",
      "minLength": 1
    },
    "dirty": {
      "type": "boolean"
    },
    "status_digest": {
      "type": "string"
    },
    "frozen_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
