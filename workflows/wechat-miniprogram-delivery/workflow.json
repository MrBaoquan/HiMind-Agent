{
  "schema_version": "workflow_package.v1",
  "id": "com.himind.workflow.wechat-miniprogram-delivery",
  "version": "1.1.0",
  "name": "微信小程序开发闭环",
  "description": "从真实需求、开发证据、测试、预览和体验版到人工验收、审核、发布与回滚的微信小程序交付工作流。",
  "min_agent_version": "0.3.47",
  "local_requirements": {
    "platform": "windows",
    "workspace": "git",
    "required_tools": [
      "node",
      "npm"
    ],
    "recommended_tools": [
      "wechat-miniprogram-devtools",
      "miniprogram-ci"
    ]
  },
  "optional_providers": [
    "himind.dashboard"
  ],
  "capabilities": [
    "wechat.miniprogram.requirements.snapshot",
    "wechat.miniprogram.project.inspect",
    "wechat.miniprogram.development.record",
    "wechat.miniprogram.dependencies.prepare",
    "wechat.miniprogram.test",
    "wechat.miniprogram.build",
    "wechat.miniprogram.preview",
    "wechat.miniprogram.upload",
    "wechat.miniprogram.acceptance.record",
    "wechat.miniprogram.review.prepare",
    "wechat.miniprogram.review.submit",
    "wechat.miniprogram.release.record",
    "wechat.miniprogram.rollback"
  ],
  "dependencies": {
    "skills": [
      "wechatide-skill"
    ],
    "plugins": [
      "com.himind.wechat-miniprogram-tools"
    ],
    "connectors": [
      "wechat-miniprogram"
    ],
    "runtimes": [
      "himind.builtin"
    ]
  },
  "steps": [
    {
      "id": "WX-01",
      "title": "需求和验收解析",
      "capability_id": "wechat.miniprogram.requirements.snapshot",
      "execution_mode": "sync",
      "risk_level": "local_write"
    },
    {
      "id": "WX-02",
      "title": "应用上下文准备",
      "capability_id": "wechat.miniprogram.project.inspect",
      "execution_mode": "sync",
      "risk_level": "read_only",
      "depends_on": ["WX-01"]
    },
    {
      "id": "WX-03",
      "title": "工作区准备",
      "capability_id": "wechat.miniprogram.dependencies.prepare",
      "execution_mode": "long_running",
      "risk_level": "process",
      "depends_on": ["WX-02"]
    },
    {
      "id": "WX-04",
      "title": "方案和任务拆分",
      "capability_id": "wechat.miniprogram.development.record",
      "input": { "stage": "plan" },
      "execution_mode": "sync",
      "risk_level": "local_write",
      "depends_on": ["WX-03"]
    },
    {
      "id": "WX-05",
      "title": "代码与资源配置",
      "capability_id": "wechat.miniprogram.development.record",
      "input": { "stage": "changes" },
      "execution_mode": "sync",
      "risk_level": "local_write",
      "depends_on": ["WX-04"]
    },
    {
      "id": "WX-06",
      "title": "静态检查和测试",
      "capability_id": "wechat.miniprogram.test",
      "execution_mode": "long_running",
      "risk_level": "process",
      "depends_on": ["WX-05"]
    },
    {
      "id": "WX-07",
      "title": "构建与预览",
      "capability_id": "wechat.miniprogram.preview",
      "execution_mode": "long_running",
      "risk_level": "network",
      "approval_required": true,
      "depends_on": ["WX-06"]
    },
    {
      "id": "WX-08",
      "title": "真实体验版上传",
      "capability_id": "wechat.miniprogram.upload",
      "execution_mode": "long_running",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": ["WX-07"]
    },
    {
      "id": "WX-09",
      "title": "人工验收",
      "capability_id": "wechat.miniprogram.acceptance.record",
      "execution_mode": "sync",
      "risk_level": "local_write",
      "depends_on": ["WX-08"]
    },
    {
      "id": "WX-10",
      "title": "组织审批",
      "execution_mode": "sync",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": ["WX-09"]
    },
    {
      "id": "WX-11",
      "title": "微信审核准备",
      "capability_id": "wechat.miniprogram.review.prepare",
      "execution_mode": "sync",
      "risk_level": "local_write",
      "depends_on": ["WX-10"]
    },
    {
      "id": "WX-12",
      "title": "提交审核",
      "capability_id": "wechat.miniprogram.review.submit",
      "execution_mode": "sync",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": ["WX-11"]
    },
    {
      "id": "WX-13",
      "title": "正式发布",
      "capability_id": "wechat.miniprogram.release.record",
      "execution_mode": "sync",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": ["WX-12"]
    },
    {
      "id": "WX-14",
      "title": "监控和回滚",
      "capability_id": "wechat.miniprogram.rollback",
      "execution_mode": "sync",
      "risk_level": "R3",
      "approval_required": true,
      "depends_on": ["WX-13"]
    }
  ],
  "artifacts": [
    {
      "id": "requirement-snapshot",
      "artifact_type": "requirement_snapshot",
      "name": "需求与验收快照",
      "required": true
    },
    {
      "id": "development-record",
      "artifact_type": "development_record",
      "name": "开发变更记录",
      "required": true
    },
    {
      "id": "test-report",
      "artifact_type": "test_report",
      "name": "测试报告",
      "schema": "artifacts/test-report.schema.json",
      "required": true
    },
    {
      "id": "preview",
      "artifact_type": "wechat_preview",
      "name": "微信预览码",
      "schema": "artifacts/preview.schema.json",
      "required": true
    },
    {
      "id": "experience-version",
      "artifact_type": "wechat_experience_version",
      "name": "体验版记录",
      "required": true
    },
    {
      "id": "acceptance-report",
      "artifact_type": "acceptance_report",
      "name": "人工验收报告",
      "schema": "artifacts/acceptance-report.schema.json",
      "required": true
    },
    {
      "id": "release-record",
      "artifact_type": "release_record",
      "name": "发布与回滚记录",
      "schema": "artifacts/release.schema.json",
      "required": true
    }
  ],
  "ui": {
    "mode": "declarative",
    "surfaces": ["agent", "dashboard"],
    "entry": "ui/workflow-view.json"
  },
  "supported_runtimes": [
    "himind.builtin",
    "personal.codex",
    "personal.github-copilot"
  ],
  "created_at": "2026-09-16T00:00:00Z"
}
