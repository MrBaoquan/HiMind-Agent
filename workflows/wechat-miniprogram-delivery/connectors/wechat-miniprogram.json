{
  "schema_version": "connector_manifest.v1",
  "id": "wechat-miniprogram",
  "version": "1.0.0",
  "name": "微信小程序上传连接器",
  "description": "为微信小程序体验版交付提供构建、CI 就绪检查和上传能力。",
  "availability": "local",
  "credential_ownership": "agent",
  "auth": ["api_key"],
  "capabilities": [
    "wechat.miniprogram.build",
    "wechat.miniprogram.ci.readiness",
    "wechat.miniprogram.upload"
  ],
  "scopes": ["wechat.miniprogram.deploy"],
  "supported_platforms": ["windows"],
  "health_check": {
    "type": "capability",
    "target": "wechat.miniprogram.ci.readiness",
    "input": {"require_ci_installed": false}
  },
  "credentials": [
    {
      "handle": "wechat-upload-private-key",
      "target": "private_key_path",
      "kind": "file_path",
      "required": false
    }
  ]
}
