{
  "schema_version": "connector_manifest.v1",
  "id": "wechat-miniprogram",
  "version": "1.0.0",
  "name": "微信小程序交付连接器",
  "description": "为微信小程序预览、体验版上传、审核证据和发布记录提供本地连接能力。",
  "availability": "local",
  "credential_ownership": "agent",
  "auth": ["api_key"],
  "capabilities": [
    "wechat.miniprogram.project.inspect",
    "wechat.miniprogram.dependencies.prepare",
    "wechat.miniprogram.test",
    "wechat.miniprogram.build",
    "wechat.miniprogram.preview",
    "wechat.miniprogram.upload",
    "wechat.miniprogram.acceptance.record",
    "wechat.miniprogram.review.prepare",
    "wechat.miniprogram.review.submit",
    "wechat.miniprogram.release.record",
    "wechat.miniprogram.rollback"
  ],
  "scopes": ["wechat.miniprogram.deploy"],
  "supported_platforms": ["windows"],
  "health_check": {
    "type": "capability",
    "target": "wechat.miniprogram.project.inspect"
  },
  "credentials": [
    {
      "handle": "wechat-upload-private-key",
      "target": "private_key_path",
      "kind": "file_path",
      "required": true
    }
  ]
}
