{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeChat Mini Program Release",
  "type": "object",
  "required": ["app_id", "candidate_id", "version", "commit_sha", "release_status"],
  "properties": {
    "app_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 1 },
    "tree_digest": { "type": "string" },
    "schema_version": { "const": "wechat_release_record.v1" },
    "release_status": {
      "enum": ["preview", "experience", "review_pending", "review_submitted", "released", "rolled_back", "monitoring", "rollback_recorded"]
    },
    "platform_evidence": { "type": "string" },
    "release_evidence": { "type": "string" },
    "recorded_at": { "type": "string" },
    "rollback_target": { "type": "string" },
    "rollback_executed": { "type": "boolean" }
  },
  "additionalProperties": false
}
