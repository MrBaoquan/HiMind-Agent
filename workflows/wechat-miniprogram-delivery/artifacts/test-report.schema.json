{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeChat Mini Program Test Report",
  "type": "object",
  "required": ["commit_sha", "checks", "status"],
  "properties": {
    "commit_sha": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "failed", "not_run"] },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
