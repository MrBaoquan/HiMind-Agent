{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeChat Mini Program Acceptance Report",
  "type": "object",
  "required": [
    "schema_version",
    "candidate_id",
    "commit_sha",
    "tree_digest",
    "tester",
    "passed",
    "evidence_paths"
  ],
  "properties": {
    "schema_version": { "const": "wechat_acceptance_report.v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 1 },
    "tree_digest": { "type": "string", "minLength": 1 },
    "tester": { "type": "string", "minLength": 1 },
    "tester_id": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "responsibility_chain": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["actor_id", "role", "action", "occurred_at"],
        "properties": {
          "actor_id": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "occurred_at": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "attested_at": { "type": "string", "minLength": 1 },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "passed": { "const": true } } },
      "then": {
        "required": [
          "tester_id",
          "evidence_signature",
          "responsibility_chain",
          "attested_at"
        ]
      }
    }
  ]
}
