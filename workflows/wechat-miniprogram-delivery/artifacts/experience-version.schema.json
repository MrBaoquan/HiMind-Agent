{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WeChat Experience Version",
  "type": "object",
  "required": ["schema_version", "candidate_id", "commit_sha", "version", "uploaded_at"],
  "properties": {
    "schema_version": { "const": "wechat_experience_version.v1" },
    "candidate_id": { "type": "string", "minLength": 1 },
    "app_id": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "commit_sha": { "type": "string", "minLength": 1 },
    "tree_digest": { "type": "string" },
    "description": { "type": "string" },
    "uploaded_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
