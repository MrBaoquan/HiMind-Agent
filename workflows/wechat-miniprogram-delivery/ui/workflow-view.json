{
  "schema_version": "workflow_view.v1",
  "title": "微信小程序开发闭环",
  "sections": [
    {
      "id": "requirement",
      "title": "需求与验收",
      "fields": [
        {
          "id": "requirement",
          "label": "需求描述",
          "type": "textarea",
          "required": true,
          "placeholder": "描述本次小程序交付目标、页面和业务规则"
        },
        {
          "id": "acceptance_criteria",
          "label": "验收标准",
          "type": "list",
          "required": true,
          "placeholder": "每行一条验收标准"
        },
        {
          "id": "constraints",
          "label": "约束条件",
          "type": "list",
          "placeholder": "每行一条技术、合规或交付约束"
        },
        {
          "id": "feedback",
          "label": "开发反馈",
          "type": "textarea",
          "placeholder": "多轮开发过程中填写需要继续修改的内容"
        }
      ],
      "artifacts": ["requirement-snapshot"]
    },
    {
      "id": "application",
      "title": "应用与仓库",
      "fields": [
        {
          "id": "workspace_root",
          "label": "工作区目录",
          "type": "text",
          "required": true,
          "placeholder": "包含小程序仓库的本地目录"
        },
        {
          "id": "project_root",
          "label": "小程序工程目录",
          "type": "text",
          "required": true,
          "placeholder": "包含 project.config.json 的目录"
        },
        {
          "id": "app_id",
          "label": "微信 AppID",
          "type": "text",
          "required": true,
          "placeholder": "wx..."
        },
        {
          "id": "credential_handles",
          "label": "上传私钥凭据",
          "type": "credential",
          "target": "private_key_path",
          "default": "wechat-upload-private-key"
        },
        {
          "id": "repository_ref",
          "label": "仓库引用",
          "type": "text",
          "placeholder": "可选：分支、Tag 或提交"
        },
        {
          "id": "branch",
          "label": "分支",
          "type": "text",
          "placeholder": "例如 feature/miniprogram"
        },
        {
          "id": "environment",
          "label": "环境",
          "type": "select",
          "default": "development",
          "options": ["development", "staging", "production"]
        },
        {
          "id": "commit_sha",
          "label": "Commit SHA",
          "type": "text",
          "placeholder": "通常由 Candidate 冻结步骤自动绑定"
        }
      ]
    },
    {
      "id": "verification",
      "title": "测试与构建",
      "fields": [
        {
          "id": "package_manager",
          "label": "包管理器",
          "type": "select",
          "default": "npm",
          "options": ["npm", "pnpm", "yarn"]
        },
        {
          "id": "install_mode",
          "label": "安装模式",
          "type": "select",
          "default": "install",
          "options": ["install", "ci"]
        },
        {
          "id": "scripts",
          "label": "验证脚本",
          "type": "list",
          "placeholder": "每行一个 npm script"
        },
        {
          "id": "version",
          "label": "版本",
          "type": "text",
          "placeholder": "例如 1.0.0"
        },
        {
          "id": "description",
          "label": "版本说明",
          "type": "text",
          "placeholder": "体验版或发布版本的说明"
        }
      ],
      "artifacts": ["test-report", "preview"]
    },
    {
      "id": "acceptance",
      "title": "体验与验收",
      "fields": [
        {
          "id": "tester",
          "label": "验收人",
          "type": "text",
          "placeholder": "填写验收责任人"
        },
        {
          "id": "passed",
          "label": "验收通过",
          "type": "boolean",
          "default": true
        },
        {
          "id": "evidence_paths",
          "label": "验收证据",
          "type": "list",
          "placeholder": "每行一个截图、视频或报告路径"
        },
        {
          "id": "notes",
          "label": "验收备注",
          "type": "textarea",
          "placeholder": "记录未覆盖项、风险和人工结论"
        }
      ],
      "artifacts": ["experience-version", "acceptance-report"]
    },
    {
      "id": "release",
      "title": "审核、发布与回滚",
      "fields": [
        {
          "id": "submission_receipt",
          "label": "审核提交凭证",
          "type": "text",
          "placeholder": "平台回执或人工提交证据引用"
        },
        {
          "id": "release_evidence_path",
          "label": "发布证据",
          "type": "text",
          "placeholder": "审核通过和发布记录文件路径"
        },
        {
          "id": "target_version",
          "label": "目标版本",
          "type": "text",
          "placeholder": "发布或回滚目标版本"
        },
        {
          "id": "rollback_requested",
          "label": "请求回滚",
          "type": "boolean",
          "default": false
        }
      ],
      "artifacts": ["release-record"]
    }
  ],
  "actions": [
    "snapshot_requirements",
    "inspect_project",
    "prepare_dependencies",
    "record_development",
    "run_tests",
    "preview",
    "upload_experience",
    "record_acceptance",
    "approve",
    "prepare_review",
    "submit_review",
    "record_release",
    "rollback"
  ]
}
