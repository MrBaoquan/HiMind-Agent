{
  "schema_version": 1,
  "name": "anthropic-to-responses",
  "pipeline": "anthropic_to_responses",
  "client": "claude-desktop",
  "provider": "openai_responses_limited",
  "protocol": "openai-responses",
  "default_model": "model-a",
  "input": {
    "model": "model-a",
    "system": "rules",
    "max_tokens": 64,
    "temperature": 0.2,
    "top_p": 0.9,
    "tools": [{"name": "read", "description": "read", "input_schema": {"type": "object"}}],
    "messages": [{"role": "user", "content": [{"type": "text", "text": "hello"}]}]
  },
  "expect": {
    "paths": {"/model": "model-a", "/max_output_tokens": 64, "/input/0/type": "message", "/input/0/role": "user", "/tools/0/type": "function"},
    "absent_paths": ["/temperature", "/top_p"],
    "forbidden_substrings": ["input_image"],
    "changes_include": ["sampling_temperature", "sampling_top_p"]
  }
}
