{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/extension-release-manifest.schema.json",
  "title": "HiMind Extension Release Manifest v1",
  "description": "发布到 GitHub Release 的扩展清单。发布侧写、消费侧读，两边共同遵守：制品摘要与依赖 pin 决定能否安装，signature 存在即必须验签通过。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "version", "artifact"],
  "properties": {
    "schema_version": { "const": "himind_extension_release.v1" },
    "repository": { "type": "string" },
    "tag": { "type": "string" },
    "kind": { "enum": ["plugin", "skill", "workflow"] },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "channel": { "type": "string" },
    "source_commit": { "type": "string" },
    "min_agent_version": { "type": "string" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "signature": {
      "description": "制品分离签名。可选：缺失表示未签名，是否允许安装由分发策略决定；一旦出现就必须验签通过。",
      "type": "object",
      "additionalProperties": false,
      "required": ["signature", "signature_key_id", "signature_algorithm"],
      "properties": {
        "file_name": { "type": "string" },
        "file_size": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "signature": { "type": "string", "minLength": 1 },
        "signature_key_id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "signature_algorithm": { "const": "rsa-pss-sha256" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "required"],
      "properties": {
        "kind": { "enum": ["plugin", "skill", "workflow"] },
        "id": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "min_version": { "type": "string" },
        "version": {
          "description": "精确 pin 的版本；为空表示未 pin，安装侧要求本机已具备。",
          "type": "string"
        },
        "sha256": { "type": "string" },
        "pinned": { "type": "boolean" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "repository", "reference", "artifact_url"],
          "properties": {
            "kind": { "type": "string" },
            "id": { "type": "string" },
            "repository": { "type": "string" },
            "reference": { "type": "string" },
            "artifact_url": { "type": "string" }
          }
        }
      }
    }
  }
}
