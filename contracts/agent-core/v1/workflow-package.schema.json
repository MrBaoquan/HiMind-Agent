{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/workflow-package.schema.json",
  "title": "HiMind Workflow Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "min_agent_version",
    "steps",
    "artifacts",
    "ui"
  ],
  "properties": {
    "schema_version": { "const": "workflow_package.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "min_agent_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "local_requirements": { "type": "object" },
    "optional_providers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": { "type": "object" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "execution_policy": {
      "enum": ["strict", "segmented", "flexible"]
    },
    "entrypoints": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "default_entrypoint": { "type": "string" },
    "exits": {
      "type": "array",
      "items": { "$ref": "#/$defs/endpoint" }
    },
    "default_exitpoint": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["standard", "declarative", "custom"] },
        "entry": { "type": "string" },
        "surfaces": {
          "type": "array",
          "items": { "enum": ["agent", "dashboard", "mcp"] },
          "uniqueItems": true
        }
      }
    },
    "supported_runtimes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string" }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator"],
      "properties": {
        "operator": {
          "enum": [
            "all",
            "any",
            "not",
            "equals",
            "not_equals",
            "exists",
            "contains",
            "gt",
            "gte",
            "lt",
            "lte"
          ]
        },
        "path": { "type": "string" },
        "value": true,
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        }
      }
    },
    "runtime_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "prompt"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 },
        "workspace_path": { "type": "string" },
        "result_schema": { "type": "string" },
        "allow_network": { "type": "boolean" },
        "input_artifacts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "tool_policy": { "enum": ["", "default", "none"] },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_iterations", "steps"],
      "properties": {
        "max_iterations": { "type": "integer", "minimum": 1, "maximum": 20 },
        "pause_for_feedback": { "type": "boolean" },
        "continue_when": { "$ref": "#/$defs/condition" },
        "exit_when": { "$ref": "#/$defs/condition" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "execution_mode"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["capability", "runtime", "manual", "loop", "provider_defined"]
        },
        "capability_id": { "type": "string" },
        "runtime": { "$ref": "#/$defs/runtime_step" },
        "loop": { "$ref": "#/$defs/loop" },
        "when": { "$ref": "#/$defs/condition" },
        "fail_when": { "$ref": "#/$defs/condition" },
        "candidate_action": { "enum": ["", "freeze", "require"] },
        "input": { "type": "object" },
        "execution_mode": {
          "enum": ["sync", "long_running", "provider_defined"]
        },
        "on_failure": {
          "enum": ["", "fail", "continue"]
        },
        "risk_level": { "type": "string" },
        "approval_required": { "type": "boolean" },
        "depends_on": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id"],
      "properties": {
        "required": { "type": "boolean" },
        "artifact_id": { "type": "string", "minLength": 1 },
        "source": { "const": "git" },
        "allow_dirty": { "type": "boolean" }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "at_step"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "at_step": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "requires": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "produces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_type", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "schema": { "type": "string" },
        "required": { "type": "boolean" },
        "validation": { "enum": ["", "strict", "advisory"] },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    }
  }
}
