{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/workflow-package.schema.json",
  "title": "HiMind Workflow Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "name",
    "min_agent_version",
    "steps",
    "artifacts",
    "ui"
  ],
  "properties": {
    "schema_version": { "const": "workflow_package.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "min_agent_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "local_requirements": { "type": "object" },
    "optional_providers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "execution_mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "capability_id": { "type": "string" },
          "execution_mode": {
            "enum": ["sync", "long_running", "provider_defined"]
          },
          "risk_level": { "type": "string" },
          "approval_required": { "type": "boolean" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "artifact_type", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "artifact_type": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "schema": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["standard", "declarative", "custom"] },
        "entry": { "type": "string" },
        "surfaces": {
          "type": "array",
          "items": { "enum": ["agent", "dashboard", "mcp"] },
          "uniqueItems": true
        }
      }
    },
    "supported_runtimes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string" }
  }
}
