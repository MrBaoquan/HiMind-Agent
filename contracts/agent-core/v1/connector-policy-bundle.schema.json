{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/connector-policy-bundle.schema.json",
  "title": "HiMind Connector Policy Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policies",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "const": "connector_policy_bundle.v1" },
    "policies": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connector_id",
          "revoked",
          "reason",
          "revision"
        ],
        "properties": {
          "connector_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "revoked": { "type": "boolean" },
          "reason": {
            "type": "string",
            "maxLength": 500
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
