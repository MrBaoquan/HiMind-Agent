{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/extension-candidate.schema.json",
  "title": "HiMind Extension Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "id",
    "version",
    "candidate_sha256",
    "workspace_root",
    "source",
    "dependencies",
    "test_report",
    "state",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "extension_candidate.v1" },
    "kind": { "$ref": "#/$defs/kind" },
    "id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "candidate_sha256": { "$ref": "#/$defs/sha256" },
    "workspace_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source": { "$ref": "#/$defs/source" },
    "dependencies": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "test_report": { "type": "object" },
    "state": {
      "enum": ["draft", "candidate", "tested", "confirmed", "submitted"]
    },
    "blockers": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "warnings": {
      "type": "array",
      "maxItems": 128,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "kind": {
      "enum": ["plugin", "skill", "workflow"]
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "enum": ["local", "github", "dashboard"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 300 },
        "repository": { "type": "string", "maxLength": 500 },
        "reference": { "type": "string", "maxLength": 300 },
        "commit": { "type": "string", "maxLength": 100 },
        "subdirectory": { "type": "string", "maxLength": 1000 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "required"],
      "properties": {
        "kind": { "$ref": "#/$defs/kind" },
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_id": { "type": "string", "maxLength": 300 },
        "required": { "type": "boolean" }
      }
    }
  }
}
