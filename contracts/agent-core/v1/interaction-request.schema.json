{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/interaction-request.schema.json",
  "title": "HiMind Workflow Interaction Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "run_id",
    "step_id",
    "kind",
    "title",
    "description",
    "required_action",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "interaction_request.v1" },
    "id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "step_id": { "type": "string", "minLength": 1 },
    "kind": {
      "enum": ["approval", "feedback", "form", "evidence", "external_wait"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "required_action": {
      "enum": ["approve_or_reject", "submit_feedback", "submit_form", "submit_evidence", "inspect_run"]
    },
    "status": { "enum": ["pending", "resolved", "expired"] },
    "source_event_id": { "type": "string" },
    "created_at": { "type": "string" },
    "risk_level": { "type": "string" },
    "schema": { "type": ["object", "null"] },
    "metadata": { "type": "object" }
  }
}
