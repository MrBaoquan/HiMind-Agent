{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://himind.dev/contracts/agent-core/v1/engineering-project.schema.json",
  "title": "HiMind Engineering Project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "name",
    "targets"
  ],
  "properties": {
    "schema_version": { "const": "engineering_project.v1" },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 120
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "uniqueItems": true
    },
    "workspace_root": { "type": "string" },
    "source_root": { "type": "string" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    },
    "workflows": { "$ref": "#/$defs/workflows" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "metadata": { "type": "object" }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 120
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 120 },
          "uniqueItems": true
        },
        "app_id": { "type": "string" },
        "source_root": { "type": "string" },
        "build_root": { "type": "string" },
        "environments": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/environment" }
        },
        "delivery": { "$ref": "#/$defs/delivery" },
        "metadata": { "type": "object" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "build_script": { "type": "string" },
        "package_manager": {
          "enum": ["npm", "pnpm", "yarn"]
        },
        "variables": { "type": "object" }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "workflow_id": { "type": "string" },
        "upload_channel": {
          "enum": ["ci", "wechatide", "manual"]
        },
        "client": { "type": "string" },
        "default_environment": {
          "enum": ["development", "production"]
        }
      }
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "string" },
        "develop": { "type": "string" },
        "deliver": { "type": "string" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "plugins": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "connectors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "runtimes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
